# Copy to .env (git-ignored) and export, or set in your process manager.

# Postgres. Required by `worker`, `migrate` and `run`; `api` falls back to memory.
SHINRIN_DATABASE_URL=postgres://shinrin:shinrin@localhost:5432/shinrin?sslmode=disable

# How far back the first sync of a new asset goes.
SHINRIN_HISTORY_START=2010-01-01

# US end-of-day prices (free key at https://www.tiingo.com). Empty disables them.
SHINRIN_TIINGO_TOKEN=

# SEC EDGAR requires an app name and a contact email. Empty disables US fundamentals.
SHINRIN_SEC_USER_AGENT="Shinrin you@example.com"

# US quotes and company news (free key at https://finnhub.io). Empty disables them.
SHINRIN_FINNHUB_TOKEN=
# B3 intraday quotes (free token at https://brapi.dev). Empty disables them.
SHINRIN_BRAPI_TOKEN=
# US macro series (free key at https://fred.stlouisfed.org). Empty disables them.
SHINRIN_FRED_API_KEY=

SHINRIN_LOG_LEVEL=info
