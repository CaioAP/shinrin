# Settings for the Shinrin api and worker. Copy to shinrin.env (git-ignored).
# Descriptions of each variable: backend/.env.example.

# Encrypts users' saved LLM keys. Generate ONCE with `openssl rand -base64 32`
# and back it up somewhere safe (a password manager): if it is lost, users
# must save their keys again.
SHINRIN_MASTER_KEY=

SHINRIN_HISTORY_START=2010-01-01
SHINRIN_SEC_USER_AGENT="Shinrin you@example.com"
SHINRIN_TIINGO_TOKEN=
SHINRIN_FINNHUB_TOKEN=
SHINRIN_BRAPI_TOKEN=
SHINRIN_FRED_API_KEY=
SHINRIN_LOG_LEVEL=info
