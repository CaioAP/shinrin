# Secrets for the Compose stack itself. Copy to .env (git-ignored).

# Generate with: openssl rand -hex 24 (hex only: it goes into a database URL)
POSTGRES_PASSWORD=

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > the
# `cloudflared ... --token <TOKEN>` install command (only the token part).
CLOUDFLARE_TUNNEL_TOKEN=
